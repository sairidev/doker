worker_processes  1;
pid        /home/container/run/nginx.pid;
error_log  /home/container/logs/nginx-error.log warn;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /home/container/logs/nginx-access.log;
    client_body_temp_path /home/container/run/nginx-client-body;
    proxy_temp_path       /home/container/run/nginx-proxy;
    fastcgi_temp_path     /home/container/run/nginx-fastcgi;
    uwsgi_temp_path       /home/container/run/nginx-uwsgi;
    scgi_temp_path        /home/container/run/nginx-scgi;

    sendfile        on;
    keepalive_timeout  65;

    server {
        # Pterodactyl/Pelican biasanya inject port via env SERVER_PORT.
        # Ganti manual kalau testing lokal tanpa panel.
        listen       ${SERVER_PORT_PLACEHOLDER};
        server_name  _;
        root         /home/container/public;
        index        index.php index.html;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            include        fastcgi_params;
            fastcgi_pass   unix:/home/container/run/php-fpm.sock;
            fastcgi_index  index.php;
            fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        }

        location ~ /\.ht {
            deny all;
        }
    }
}
